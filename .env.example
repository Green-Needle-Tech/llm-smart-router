# Required
OPENROUTER_API_KEY=sk-or-...

# Router auth (if auth.enabled)
ROUTER_API_KEY=your-router-key

# Admin endpoints
ADMIN_API_KEY=your-admin-key

# Per-tier provider API keys (optional — overrides global OPENROUTER_API_KEY)
# Set these when a tier uses a different LLM provider.
# The env var name goes into settings.json's tier.api_key_env field.
# Example:
#   L1_API_KEY=sk-...
#   CLASSIFIER_API_KEY=sk-...