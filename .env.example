# Required
OPENROUTER_API_KEY=sk-or-...

# Router auth (if auth.enabled)
ROUTER_API_KEY=your-router-key

# Admin endpoints
ADMIN_API_KEY=your-admin-key

# Optional overrides
CACHE_BACKEND=memory
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
SESSION_ENABLED=true
SESSION_IDLE_TTL_SECONDS=7200
SESSION_FINGERPRINT_SALT=
WORKERS=1
PORT=8080
